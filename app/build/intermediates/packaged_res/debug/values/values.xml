<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_background">#0a0a0f</color>
    <color name="ic_foreground">#00ff88</color>
    <style name="Theme.GhostLock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">#00ff88</item>
        <item name="android:colorPrimaryDark">#0a0a0f</item>
        <item name="android:colorAccent">#00ff88</item>
