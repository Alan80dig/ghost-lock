<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0f"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👻 Ghost Lock"
            android:textSize="28sp"
            android:textColor="#00ff88"
            android:layout_marginBottom="24dp" />

        <!-- Статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Защита"
                android:textSize="16sp"
                android:textColor="#ffffff" />

            <Switch
                android:id="@+id/switchService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#888888"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="24dp"
            android:background="#12121a"
            android:padding="12dp" />

        <!-- Чувствительность -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textSize="14sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSensitivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Чувствительность: Средняя"
            android:textSize="14sp"
            android:textColor="#cccccc"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="32dp" />

        <!-- Удаление -->
        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Отключить и удалить"
            android:textColor="#ff4444"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
