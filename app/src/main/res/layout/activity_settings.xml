<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0f"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghost Lock"
            android:textSize="28sp"
            android:textColor="#00ff88"
            android:layout_marginBottom="24dp" />

        <!-- Статус -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#888888"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="24dp"
            android:background="#12121a"
            android:padding="12dp" />

        <!-- Чувствительность -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настрой перед использованием"
            android:textSize="14sp"
            android:textColor="#666666"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSensitivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Чувствительность: Средняя"
            android:textSize="14sp"
            android:textColor="#cccccc"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="16dp" />

        <!-- Кнопка Готово -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ГОТОВО"
            android:textColor="#0a0a0f"
            android:backgroundTint="#00ff88"
            android:layout_marginBottom="32dp" />

        <!-- Игнорировать оптимизацию батареи -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Не отключать в фоне"
                android:textSize="14sp"
                android:textColor="#cccccc" />

            <Switch
                android:id="@+id/switchBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рекомендуется включить, чтобы Ghost Lock не отключался системой"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- Switch отключения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отключить защиту"
                android:textSize="14sp"
                android:textColor="#ff4444" />

            <Switch
                android:id="@+id/switchService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Удаление -->
        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Удалить приложение"
            android:textColor="#ff4444"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>